{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=$NG_HOST;Port=5432;Database=$NG_DATABASE;Username=$NG_USERNAME;Password=$NG_PASSWORD"
  },
  "Kestrel": { "Endpoints": { "http": { "Url": "http://+:9090" } } }
}
